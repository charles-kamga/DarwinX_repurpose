# ==============================================================================
# Darwinx_Repurpose — Configuration de l'Environnement (.env.example)
# ==============================================================================
# Copiez ce fichier en .env et renseignez vos clés d'API personnelles ci-dessous.
# Ne committez JAMAIS votre fichier .env réel sur Git.

# ------------------------------------------------------------------------------
# 1. Fournisseurs LLM (Scoring des moments viraux)
# ------------------------------------------------------------------------------
# Provider sélectionné : "auto" (Groq -> Gemini -> Mistral -> Anthropic)
# ou forcé : "groq", "gemini", "mistral", "anthropic"
LLM_PROVIDER="auto"

# Renseignez au moins une clé (Groq et Gemini sont gratuits) :
GROQ_API_KEY=""
GEMINI_API_KEY=""
MISTRAL_API_KEY=""
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Transcription Audio (faster-whisper)
# ------------------------------------------------------------------------------
# "auto" (détecte CUDA NVIDIA cuBLAS/cuDNN si dispo, sinon CPU), "cuda", ou "cpu"
WHISPER_DEVICE="auto"
# WHISPER_MODEL_SIZE="medium"

# ------------------------------------------------------------------------------
# 3. Notifications Telegram (Optionnel - Suivi distant en temps réel)
# ------------------------------------------------------------------------------
# Pour créer un bot : @BotFather sur Telegram -> /newbot
# Pour obtenir votre Chat ID : envoyez un message à @userinfobot
DARWINX_TELEGRAM_BOT_TOKEN=""
DARWINX_TELEGRAM_CHAT_ID=""

# Timeout réseau pour l'envoi de messages Telegram (en secondes)
TELEGRAM_TIMEOUT_SEC=5.0
